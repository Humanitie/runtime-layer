# Intended path: backend/.env.example
# Copy this file to ".env" (in the same folder as humaniti_backend_app.py) and fill in values.
# (Delivered as .txt here because some file pickers hide dotfiles by default —
# just rename it to ".env" after copying.)

# ---------------------------------------------------------------------------
# AI_MODE selects the reasoning provider strategy. See humaniti_backend_runtime_engine.py
# -> AIProviderManager for the full behavior of each mode.
#
#   production  -> always attempt the Claude API; falls back to the Enterprise
#                  Scenario Engine only if the call itself fails (network,
#                  invalid key, no credits, timeout).
#   demo        -> never calls an external API. Always uses the Enterprise
#                  Scenario Engine. Zero API cost, zero network dependency,
#                  fully deterministic — built for stakeholder demos.
#   auto        -> behaves like "production" if ANTHROPIC_API_KEY is set,
#                  otherwise behaves like "demo". (default if unset)
# ---------------------------------------------------------------------------
AI_MODE=demo

# Required when AI_MODE is "production" or "auto" with a key present.
ANTHROPIC_API_KEY=

# Used by docker-compose / a real deployment. The reference build in this
# package runs retrieval in-memory and does not require this to be set to
# run the test suite or `uvicorn ... --reload` locally.
DATABASE_URL=postgresql://humaniti:humaniti_dev_password@localhost:5432/humaniti

# Reserved for when RAGPipeline.retrieve() is swapped from keyword-overlap
# scoring to real pgvector/Chroma embeddings.
VECTOR_DB_URL=
